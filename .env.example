APP_NAME="Chery Arta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Di Railway nilainya LOG_CHANNEL=stderr — storage/logs ikut hilang tiap redeploy.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database bersama di Railway (keputusan R2) -----------------------------
# Development dan deployment memakai SATU database yang sama, supaya laptop dan
# PC kantor otomatis melihat data yang identik tanpa sinkronisasi apa pun.
#
# Dari komputer developer, koneksinya lewat TCP proxy publik Railway — BUKAN
# host internal `mysql.railway.internal`, yang hanya bisa dicapai dari dalam
# Railway. Ambil nilainya di service MySQL → Variables & Settings → Networking.
# Langkah lengkap: docs/12-panduan-instalasi-deploy.md §12.2 dan §12.3.1.
#
# Minta nilainya ke pemilik proyek — jangan menebak, dan jangan pernah menulis
# kredensial sungguhan ke berkas ini.
DB_CONNECTION=mysql
DB_HOST=<RAILWAY_TCP_PROXY_DOMAIN>
DB_PORT=<RAILWAY_TCP_PROXY_PORT>
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=<MYSQLPASSWORD>

# Ketiganya WAJIB `database`, bukan `file`: filesystem Railway ephemeral,
# sehingga driver `file` membuat pengguna ter-logout acak setiap redeploy.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Tidak ada berkas unggahan di disk (keputusan R3) — karena itu tidak ada
# `storage:link` dan tidak ada disk `public`. Semua gambar ke Cloudinary.
FILESYSTEM_DISK=local

CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Cloudinary (keputusan R3) ----------------------------------------------
# Bentuknya cloudinary://<api_key>:<api_secret>@<cloud_name>, disalin dari
# Dashboard Cloudinary → API Environment variable. Lihat docs/12 §12.5.
#
# Setel CLOUDINARY_FAKE=true bila ingin bekerja tanpa akun Cloudinary: seluruh
# unggahan dialihkan ke FakeImageUploader dan tidak ada panggilan jaringan.
CLOUDINARY_URL=
CLOUDINARY_FAKE=false

# --- Chery Arta -------------------------------------------------------------
COMPANY_WA_NUMBER=6289540454690
COMPANY_INSTAGRAM=
COMPANY_FACEBOOK=
COMPANY_MAPS_URL=
WHATSAPP_DRIVER=click_to_chat
